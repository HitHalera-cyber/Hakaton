{
  "name": "guitar-chords-studio",
  "productName": "GuitarChordsStudio",
  "version": "2.0.0",
  "description": "Гитарные аккорды Studio: гриф, распознавание, песенник, практика с проверкой по микрофону",
  "author": "Hakaton",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "harness": "vite --config vite.harness.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"harness/**/*.ts\" electron",
    "check": "tsc --noEmit && vitest run && prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "android:sync": "npm run build && cap sync android"
  },
  "build": {
    "appId": "com.hakaton.guitarchords.studio",
    "productName": "GuitarChordsStudio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Гитарные аккорды Studio",
      "artifactName": "GuitarChordsStudio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GuitarChordsStudio-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Микрофон нужен для тюнера и распознавания аккордов по звуку."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron-updater": "^6.8.9",
    "zustand": "^5.0.15"
  },
  "desktopName": "guitarchordsstudio.desktop"
}
