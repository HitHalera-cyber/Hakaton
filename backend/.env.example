# Copy to .env and adjust. All variables are optional — the service runs
# with public, keyless endpoints by default (CelesTrak, NOAA SWPC, and
# NASA's DEMO_KEY for DONKI, which has a low rate limit).

# Get a free personal key at https://api.nasa.gov/ to raise the DONKI rate
# limit above DEMO_KEY's ~30 requests/hour.
EVA_NASA_API_KEY=DEMO_KEY

# Optional: only needed for authenticated Space-Track GP_HISTORY (true
# historical orbital elements). Without these, historical orbit geometry is
# reconstructed from the freshest available current elements and clearly
# labeled as a reconstruction, not a verified historical position.
EVA_SPACETRACK_IDENTITY=
EVA_SPACETRACK_PASSWORD=

# Cache / freshness tuning.
EVA_CURRENT_DATA_TTL_SECONDS=300
EVA_HTTP_TIMEOUT_SECONDS=20

# Optional: route ALL outbound requests (NASA, NOAA, CelesTrak) through a
# proxy. Use this if api.nasa.gov (or another source) is unreachable or
# blocked from your network/region. Only NASA DONKI (historical mode +
# the T5 experiment) actually needs this in practice — "Текущая обстановка"
# mode does not call NASA at all.
# Examples:
#   EVA_HTTP_PROXY=http://user:pass@proxyhost:3128
#   EVA_HTTP_PROXY=socks5://127.0.0.1:1080   (needs: pip install "httpx[socks]")
EVA_HTTP_PROXY=
