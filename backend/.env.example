# Copy to .env and adjust. All variables are optional — the service runs
# with public, keyless endpoints by default (CelesTrak, NOAA SWPC, and
# NASA's DEMO_KEY for DONKI, which has a low rate limit).

# Get a free personal key at https://api.nasa.gov/ to raise the DONKI rate
# limit above DEMO_KEY's ~30 requests/hour.
EVA_NASA_API_KEY=DEMO_KEY

# Optional, free account at https://www.space-track.org/: used for
# authenticated Space-Track GP_HISTORY (true historical orbital elements —
# without these, historical orbit geometry is reconstructed from the
# freshest available current elements and clearly labeled as a
# reconstruction, not a verified historical position). ALSO used as an
# automatic fallback in "Текущая обстановка" mode if CelesTrak itself is
# unreachable — CelesTrak needs no account and stays the preferred source
# whenever it works, but some hosts (observed on at least one free-tier
# PaaS deployment) have outbound traffic to celestrak.org blocked or
# rate-limited; Space-Track runs on different infrastructure and may not
# share that problem. Leave both empty to skip this fallback entirely.
EVA_SPACETRACK_IDENTITY=
EVA_SPACETRACK_PASSWORD=

# Cache / freshness tuning.
EVA_CURRENT_DATA_TTL_SECONDS=300
EVA_HTTP_TIMEOUT_SECONDS=20

# Optional: route ALL outbound requests (NASA, NOAA, CelesTrak) through a
# proxy. Use this if api.nasa.gov (or another source) is unreachable or
# blocked from your network/region. Only NASA DONKI (historical mode +
# the T5 experiment) actually needs this in practice — "Текущая обстановка"
# mode does not call NASA at all.
# Examples:
#   EVA_HTTP_PROXY=http://user:pass@proxyhost:3128
#   EVA_HTTP_PROXY=socks5://127.0.0.1:1080   (needs: pip install "httpx[socks]")
EVA_HTTP_PROXY=

# Alternative to EVA_HTTP_PROXY, specific to NASA DONKI only: point this at
# your own reverse proxy instead of api.nasa.gov directly. See
# tools/donki-proxy-worker.js for a free, self-owned Cloudflare Worker you
# can deploy in a few minutes if api.nasa.gov itself is blocked.
#   EVA_DONKI_BASE_URL=https://<your-worker>.workers.dev
EVA_DONKI_BASE_URL=https://api.nasa.gov/DONKI
